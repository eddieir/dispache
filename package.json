{
  "name": "dispache",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/jest-dom": "^4.2.4",
    "@testing-library/react": "^9.5.0",
    "@testing-library/user-event": "^7.2.1",
    "firebase": "^7.13.2",
    "lighthouse": "^5.6.0",
    "moment": "^2.24.0",
    "node-sass": "^4.13.1",
    "react": "^16.13.1",
    "react-dom": "^16.13.1",
    "react-icons": "^3.9.0",
    "react-scripts": "3.4.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test --watchAll",
    "eject": "react-scripts eject"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/index.js",
      "!src/firebase.js",
      "!src/hooks/*.js",
      "!src/context/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    },
    "coverageReporters": [
      "html",
      "text"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "lodash": ">=4.17.21",
    "lodash.template": ">=4.5.0",
    "shell-quote": ">=1.8.1",
    "flatted": ">=3.2.9",
    "word-wrap": ">=1.2.4",
    "semver": ">=7.5.4",
    "tar": ">=6.2.1",
    "tough-cookie": ">=4.1.3",
    "browserslist": ">=4.16.5",
    "brace-expansion": ">=1.1.11",
    "js-yaml": ">=3.13.1",
    "@xmldom/xmldom": ">=0.8.8",
    "ws": ">=7.4.6"
  }
}
